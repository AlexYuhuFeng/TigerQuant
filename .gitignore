out/
*.jsonl
!tests/fixtures/**/*.jsonl
!docs/evidence/**/*.jsonl

# --- Secrets and local overrides (never commit) ---------------------------
.env
.env.*
.secrets/
*.pem
*.key
secrets/
config/local.yaml
config/*.local.yaml

