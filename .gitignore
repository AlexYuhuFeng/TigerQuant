# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- Tooling caches (kept out of Git; local scratch only) ------------------
.pytest_cache/
.pytest-tmp/
pytest-cache-files-*/
